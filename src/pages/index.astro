---
import Icon from '../components/Icon.astro';
import LinePill from '../components/LinePill.astro';
import Panel from '../components/Panel.astro';
import { PROFILE } from '../data/profile';
import { lineStyle } from '../data/sections';
import { docUrl, getAttackCoverage, getDocs, getRecentDocs, getSectionTrees, getStats, sectionOf } from '../lib/content';
import { countQueries, getEventMemo, getTopTags, tagEvidence } from '../lib/home';
import { docTypeLabel, formatDate } from '../lib/nav';
import Shell from '../layouts/Shell.astro';

const docs = await getDocs();
const stats = getStats(docs);
const sections = getSectionTrees(docs);
const coverage = getAttackCoverage(docs);
const covered = coverage.filter((c) => c.techniques.length > 0);
const recent = getRecentDocs(docs, 6);
const memo = getEventMemo(docs, 12);
const topTags = getTopTags(docs, 6);
const sectionUrl = (dir: string) => docUrl(dir);
const techniquesUrl = docUrl('03-menaces-detection');
const plural = (n: number, word: string) => `${n} ${word}${n > 1 ? 's' : ''}`;

/** Une adresse e-mail saisie telle quelle devient un lien `mailto:`. */
const contactHref = (value: string) => (/^[^\s@/:]+@[^\s@/]+$/.test(value) ? `mailto:${value}` : value);

/** Le CV est un fichier de `public/` : son nom est résolu sous la base du site. */
const cvHref = (file: string) => (!file || /^https?:/.test(file) ? file : `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${file}`);

/** Sites externes et CV s'ouvrent dans un nouvel onglet ; `mailto:` et ancres restent sur place. */
const links = [
  { label: 'Télécharger mon CV', href: cvHref(PROFILE.links.cv), primary: true, newTab: true },
  { label: 'LinkedIn', href: PROFILE.links.linkedin, newTab: true },
  { label: 'GitHub', href: PROFILE.links.github, newTab: true },
  { label: 'TryHackMe', href: PROFILE.links.tryhackme, newTab: true },
  { label: 'Me contacter', href: contactHref(PROFILE.links.contact) },
]
  .filter((l) => l.href)
  .map((l) => ({ ...l, attrs: l.newTab ? { target: '_blank', rel: 'noopener noreferrer' } : {} }));

const state = [
  ['Fiches', String(stats.pages)],
  ['Techniques ATT&CK', String(stats.techniques)],
  ['Write-ups', String(stats.writeups)],
  ['Requêtes SPL / KQL', String(countQueries(docs))],
  ['Dernière mise à jour', stats.lastUpdated ? formatDate(stats.lastUpdated) : '—'],
] as const;

// Méthode appliquée à chaque fiche technique : une ligne à quatre stations, dans l'ordre des sections du modèle.
// Chaque station prend la couleur de la section où ce savoir vit : observer (01), détecter et qualifier (03), répondre (04).
const method = [
  { num: '01', title: 'Observer', body: 'Les traces que laisse le comportement : journaux, Event IDs, trafic.' },
  { num: '03', title: 'Détecter', body: 'Une requête par outil (SPL, KQL, Sigma), avec ce qu’elle cherche.' },
  { num: '03', title: 'Qualifier', body: 'Faux positifs connus et pièges documentés avant toute escalade.' },
  { num: '04', title: 'Répondre', body: 'Actions de réponse, puis lien vers le write-up où je l’ai pratiqué.' },
];

const coverageNote =
  covered.length === 0
    ? 'Aucune technique documentée pour l’instant : les stations se rempliront au fil des fiches.'
    : `${plural(stats.techniques, 'technique')} documentée${stats.techniques > 1 ? 's' : ''}, ${covered.length === 1 ? `toutes en ${covered[0]!.tactic.name}` : `réparties sur ${covered.length} tactiques`}. Les autres tactiques se rempliront au fil des fiches.`;
---

<Shell>
  <div class="home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-main">
        <p class="status">{PROFILE.status}</p>
        <h1 id="hero-title">Carnet d'analyste SOC : tout ce que j'apprends, documenté pour être retrouvé.</h1>
        <p class="intro">
          {PROFILE.intro}{' '}
          Chaque concept, filtre, requête et investigation passe par ici, avec la même méthode : ce qu'on observe, comment on le détecte,
          comment on y répond.
        </p>
        <div class="actions">
          {
            links.map((l) => (
              <a class:list={['btn', { primary: l.primary }]} href={l.href} {...l.attrs}>
                {l.label}
              </a>
            ))
          }
          <a class="more" href="#parcours">Parcours et formation</a>
        </div>

        <div class="method" aria-labelledby="method-title">
          <h2 id="method-title">La même méthode sur chaque fiche</h2>
          <ol>
            {
              method.map((m) => (
                <li style={lineStyle(m.num)}>
                  <span class="method-title">{m.title}</span>
                  <span class="method-body">{m.body}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      <aside class="state" aria-labelledby="state-title">
        <h2 id="state-title">État de la base</h2>
        <dl>
          {
            state.map(([label, value]) => (
              <div>
                <dt>{label}</dt>
                <dd>{value}</dd>
              </div>
            ))
          }
        </dl>
        {
          PROFILE.inProgress && (
            <p class="in-progress">
              En cours : <span>{PROFILE.inProgress}</span>
            </p>
          )
        }
      </aside>
    </section>

    <section class="search-block" aria-labelledby="search-title">
      <h2 id="search-title">Que cherches-tu ?</h2>
      <button type="button" class="search-lg" data-action="open-search">
        <Icon name="search" size="lg" />
        <span class="search-text">Filtre Wireshark, Event ID, technique, requête…</span>
        <span class="search-keys" aria-hidden="true"><kbd class="kbd">Ctrl</kbd><kbd class="kbd">K</kbd></span>
      </button>
      {
        topTags.length > 0 && (
          <div class="frequent">
            <span>Fréquent :</span>
            {topTags.slice(0, 5).map((t) => (
              <button type="button" class="chip" data-action="open-search" data-query={`#${t.tag}`}>
                #{t.tag}
              </button>
            ))}
          </div>
        )
      }
      <p class="hints">
        Préfixes : <code>id:</code> Event ID, <code>t:</code> technique, <code>f:</code> filtre, <code>q:</code> requête,
        <code>wu:</code> write-up, <code>pb:</code> playbook.
      </p>
    </section>

    <section class="pair">
      <Panel title="Reprendre" note="épinglés, puis vus récemment">
        <ul class="resume" data-resume></ul>
        <p class="empty" data-resume-empty>
          Rien à reprendre pour l'instant. Sur une fiche, appuie sur <kbd class="kbd">p</kbd> pour l'épingler ici ; les dernières pages vues
          s'ajoutent toutes seules.
        </p>
        <template data-resume-template>
          <li>
            <a>
              <span class="resume-type"></span>
              <span class="resume-title"></span>
              <span class="resume-mark"><Icon name="pin" size="sm" /><span class="resume-mark-text"></span></span>
            </a>
          </li>
        </template>
      </Panel>
      <Panel title="Mémo express des Event IDs" note={memo.length > 0 ? 'clic : la fiche' : undefined}>
        {
          memo.length > 0 ? (
            <div class="memo">
              {memo.map((m) => (
                <a href={m.href}>
                  <span class="memo-id">{m.id}</span>
                  <span class="memo-label">{m.label}</span>
                </a>
              ))}
            </div>
          ) : (
            <p class="empty">Aucun Event ID documenté pour l'instant. Ils apparaîtront ici dès la première fiche Windows.</p>
          )
        }
      </Panel>
    </section>

    <section class="block" aria-labelledby="sections-title">
      <div class="block-head">
        <h2 id="sections-title">Les neuf sections</h2>
        <p class="note">Chaque section a son numéro et sa couleur, repris sur toutes les pages.</p>
      </div>
      <ol class="lines">
        {
          sections.map(({ section, index, entries }) => (
            <li style={lineStyle(section.num)}>
              <a href={sectionUrl(section.dir)} class:list={{ has: entries.length > 0 }}>
                <span class="bar" aria-hidden="true" />
                <span class="name">
                  <LinePill num={section.num} size="lg" decorative />
                  <span>
                    <span class="visually-hidden">Section {section.num}, </span>
                    {section.title}
                  </span>
                </span>
                <span class="desc">{index?.data.description}</span>
                <span class="count">{plural(entries.length, 'fiche')}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="block" aria-labelledby="attack-title">
      <div class="block-head">
        <h2 id="attack-title">Couverture MITRE ATT&amp;CK</h2>
        <p class="note">Enterprise, {coverage.length} tactiques. Une station pleine : au moins une technique documentée avec sa détection.</p>
      </div>
      <ol class="tactics" aria-label="Techniques documentées par tactique">
        {
          coverage.map(({ tactic, techniques }) => (
            <li class:list={{ on: techniques.length > 0 }}>
              <a href={`${techniquesUrl}#${tactic.id}`}>
                <span class="tactic-id" aria-hidden="true">{tactic.id}</span>
                <span class="tactic-name">{tactic.name}</span>
                <span class="tactic-count">
                  {techniques.length}
                  <span class="visually-hidden"> {techniques.length > 1 ? 'techniques documentées' : 'technique documentée'}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <p class="legend">{coverageNote}</p>
    </section>

    <section class="block" aria-labelledby="recent-title">
      <div class="block-head">
        <h2 id="recent-title">Derniers ajouts</h2>
      </div>
      {
        recent.length > 0 ? (
          <ol class="recent">
            {recent.map((doc) => {
              const num = sectionOf(doc)?.num;
              return (
                <li style={lineStyle(num)}>
                  <span class="recent-date">{formatDate(doc.data.updated).slice(0, 5)}</span>
                  <span class="recent-type">
                    {num && <LinePill num={num} size="sm" decorative />}
                    {docTypeLabel(doc)}
                  </span>
                  <span class="recent-main">
                    <a class="recent-title" href={docUrl(doc.id)}>
                      {doc.data.title}
                    </a>
                    {doc.data.type === 'technique' && <span class="mitre">{doc.data.attack_id}</span>}
                  </span>
                  <span class="recent-tags">
                    {doc.data.tags.slice(0, 2).map((tag) => (
                      <button type="button" class="chip" data-action="open-search" data-query={`#${tag}`}>
                        #{tag}
                      </button>
                    ))}
                  </span>
                </li>
              );
            })}
          </ol>
        ) : (
          <p class="empty boxed">Aucune fiche publiée pour l'instant.</p>
        )
      }
    </section>

    <section class="block parcours" id="parcours" aria-labelledby="parcours-title">
      <div class="block-head">
        <h2 id="parcours-title">Parcours et formation</h2>
        <p class="note">Chaque compétence renvoie aux fiches et aux write-ups qui la prouvent : rien n'est affirmé sans page derrière.</p>
      </div>
      <div class="duo">
        <Panel title="Compétences prouvées">
          {
            topTags.length > 0 ? (
              <ul class="skills">
                {topTags.map((t) => (
                  <li>
                    <button type="button" class="chip" data-action="open-search" data-query={`#${t.tag}`}>
                      #{t.tag}
                      <span class="evidence">{tagEvidence(t)}</span>
                    </button>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="empty">Les compétences apparaîtront avec les premières fiches, à partir de leurs tags.</p>
            )
          }
        </Panel>
        <Panel title="Formation et certifications">
          {
            PROFILE.formation.length > 0 ? (
              <ul class="formation">
                {PROFILE.formation.map((f) => (
                  <li>
                    <span class="period">{f.period}</span>
                    <span>
                      <span class="item-title">{f.title}</span>
                      <span class="item-body">{f.detail}</span>
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="empty">À compléter.</p>
            )
          }
        </Panel>
      </div>
      {
        links.length > 0 && (
          <div class="actions">
            {links
              .filter((l) => l.primary || l.label === 'Me contacter')
              .map((l) => (
                <a class:list={['btn', { primary: l.primary }]} href={l.href} {...l.attrs}>
                  {l.label}
                </a>
              ))}
          </div>
        )
      }
    </section>
  </div>
</Shell>

<style>
  .home {
    max-width: var(--home-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--sp-20);
  }

  ul,
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  p {
    margin: 0;
  }

  /* Accroche */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--hero-side);
    gap: var(--sp-16);
    align-items: start;
  }

  .hero-main {
    min-width: 0;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-4);
    padding: var(--sp-2) var(--sp-6) var(--sp-2) var(--sp-4);
    border-radius: var(--r-pill);
    background: var(--sev-low-bg);
    color: var(--sev-low);
    font-size: var(--fs-md);
    font-weight: var(--fw-bold);
    line-height: var(--lh-snug);
  }

  .status::before {
    content: '';
    width: var(--dot-lg);
    height: var(--dot-lg);
    border-radius: 50%;
    background: currentColor;
  }

  h1 {
    margin: var(--sp-8) 0 var(--sp-9);
    max-width: 22ch;
    font-size: var(--fs-hero);
    line-height: var(--lh-hero);
  }

  .intro {
    max-width: var(--hero-lead-max);
    margin-bottom: var(--sp-10);
    font-size: var(--fs-lead);
    color: var(--text-2);
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-5);
  }

  .more {
    display: inline-flex;
    align-items: center;
    min-height: var(--btn-h);
    margin-left: var(--sp-3);
    font-weight: var(--fw-bold);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  /* Méthode d'investigation : la ligne que suit chaque fiche */
  .method {
    margin-top: var(--sp-16);
    padding-top: var(--sp-10);
    border-top: var(--bw) solid var(--border);
  }

  .method h2 {
    margin-bottom: var(--sp-9);
    font-size: var(--fs-base);
    font-weight: var(--fw-medium);
    color: var(--text-2);
  }

  .method ol {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    counter-reset: method;
  }

  .method ol::before {
    content: '';
    position: absolute;
    left: var(--sp-9);
    right: var(--sp-9);
    top: calc(var(--pill) / 2 - var(--track-w) / 2);
    height: var(--track-w);
    border-radius: var(--r-sm);
    background: linear-gradient(90deg, var(--l01) 0 33%, var(--l03) 0 67%, var(--l04) 0);
  }

  .method li {
    position: relative;
    padding: calc(var(--pill) + var(--sp-6)) var(--sp-6) 0 0;
    counter-increment: method;
  }

  .method li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: var(--pill);
    height: var(--pill);
    border-radius: 50%;
    background: var(--surface);
    border: var(--sp-3) solid var(--line);
    box-sizing: border-box;
  }

  /* Un seul moment animé sur le site : au chargement, le tracé de la méthode se dessine et ses stations apparaissent. */
  @media (prefers-reduced-motion: no-preference) {
    .method ol::before {
      transform-origin: left center;
      animation: draw-track 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }

    .method li::before {
      animation: pop-station 0.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: calc(0.25s + var(--i) * 0.18s);
    }

    .method li:nth-child(1) {
      --i: 0;
    }

    .method li:nth-child(2) {
      --i: 1;
    }

    .method li:nth-child(3) {
      --i: 2;
    }

    .method li:nth-child(4) {
      --i: 3;
    }
  }

  @keyframes draw-track {
    from {
      transform: scaleX(0);
    }
  }

  @keyframes pop-station {
    from {
      transform: scale(0.4);
      opacity: 0;
    }
  }

  .method-title {
    display: block;
    font-size: var(--fs-h3);
    font-weight: var(--fw-black);
  }

  .method-title::before {
    content: counter(method) '  ';
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--text-3);
  }

  .method-body {
    display: block;
    max-width: 30ch;
    margin-top: var(--sp-2);
    font-size: var(--fs-base);
    line-height: var(--lh-snug);
    color: var(--text-2);
  }

  /* État de la base : tableau d'affichage */
  .state {
    border: var(--bw) solid var(--border);
    border-radius: var(--r-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .state h2 {
    padding: var(--sp-6) var(--sp-8);
    background: var(--ink);
    color: var(--on-ink);
    font-size: var(--fs-base);
    font-weight: var(--fw-bold);
    letter-spacing: 0;
  }

  .state dl {
    margin: 0;
    padding: var(--sp-2) var(--sp-8) var(--sp-4);
  }

  .state dl > div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-6);
    padding: var(--sp-5) 0;
    border-bottom: var(--bw) solid var(--border-soft);
    font-size: var(--fs-base);
  }

  .state dl > div:last-child {
    border-bottom: none;
  }

  .state dt {
    color: var(--text-2);
  }

  .state dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-stat);
    font-weight: var(--fw-bold);
    text-align: right;
  }

  .state dl > div:last-child dd {
    font-size: var(--fs-base);
  }

  .in-progress {
    padding: var(--sp-5) var(--sp-8) var(--sp-7);
    border-top: var(--bw) solid var(--border-soft);
    font-size: var(--fs-md);
    color: var(--text-2);
  }

  .in-progress span {
    color: var(--text);
    font-weight: var(--fw-bold);
  }

  /* Grande recherche */
  .search-block h2 {
    margin-bottom: var(--sp-5);
    font-size: var(--fs-h3);
  }

  .search-lg {
    width: 100%;
    display: flex;
    align-items: center;
    gap: var(--sp-7);
    min-height: var(--search-lg-h);
    padding: 0 var(--sp-8) 0 var(--sp-9);
    background: var(--surface);
    border: var(--bw-strong) solid var(--ink);
    border-radius: var(--r-dialog);
    cursor: pointer;
    text-align: left;
    font-size: var(--fs-lead);
    color: var(--text-3);
  }

  .search-lg:hover {
    color: var(--text);
  }

  .search-lg :global(.icon) {
    color: var(--text);
  }

  .search-text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-keys {
    display: flex;
    gap: var(--sp-2);
  }

  .frequent {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4);
    margin-top: var(--sp-7);
    font-size: var(--fs-base);
    color: var(--text-2);
  }

  .frequent .chip {
    cursor: pointer;
  }

  .hints {
    margin-top: var(--sp-5);
    font-size: var(--fs-md);
    color: var(--text-3);
  }

  .hints code {
    color: var(--text-2);
    font-weight: var(--fw-bold);
  }

  /* Reprendre + mémo */
  .pair,
  .duo {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(var(--panel-min), 100%), 1fr));
    gap: var(--sp-8);
  }

  .empty {
    padding: 0 var(--sp-8) var(--sp-8);
    font-size: var(--fs-base);
    line-height: var(--lh-ui);
    color: var(--text-2);
  }

  .empty.boxed {
    padding: var(--sp-10);
    border: var(--bw-strong) dashed var(--border-strong);
    border-radius: var(--r-card);
    text-align: center;
  }

  .resume {
    display: flex;
    flex-direction: column;
    padding: 0 var(--sp-4) var(--sp-4);
  }

  .resume:empty {
    display: none;
  }

  .resume a {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
    min-height: var(--ctl);
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--r-md);
    color: var(--text);
    line-height: var(--lh-snug);
  }

  .resume a:hover {
    background: var(--bg);
    text-decoration: none;
  }

  .resume-type {
    width: var(--resume-type-w);
    flex: none;
    font-size: var(--fs-sm);
    color: var(--text-3);
  }

  .resume-title {
    flex: 1;
    min-width: 0;
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-medium);
  }

  .resume-mark {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--text-3);
  }

  .resume :global(.is-pinned) .resume-mark {
    color: var(--text);
  }

  .resume :global(a:not(.is-pinned) .icon) {
    display: none;
  }

  .memo {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--memo-min), 1fr));
    gap: var(--bw);
    background: var(--border-soft);
    border-top: var(--bw) solid var(--border-soft);
  }

  .memo a {
    display: flex;
    flex-direction: column;
