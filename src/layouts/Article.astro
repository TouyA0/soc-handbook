---
// Page de contenu : fil d'Ariane, en-tête, corps, pied d'article et colonne de droite.
import type { MarkdownHeading } from 'astro';
import ArticleAside from '../components/ArticleAside.astro';
import ArticleFooter from '../components/ArticleFooter.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import PinButton from '../components/PinButton.astro';
import TocSheet from '../components/TocSheet.astro';
import { getBacklinks, getDocs, getNeighbors, type Doc } from '../lib/content';
import { formatDate, getCrumbs, readingTime } from '../lib/nav';
import Shell from './Shell.astro';

interface Props {
  doc: Doc;
  headings: MarkdownHeading[];
}

const { doc, headings } = Astro.props;
const docs = await getDocs();
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const updated = formatDate(doc.data.updated);
---

<Shell title={doc.data.title} description={doc.data.description} doc={doc} statusMeta={`maj ${updated}`}>
  <div class="wrap">
    <article>
      <div class="top">
        <Breadcrumb crumbs={getCrumbs(doc)} />
        <div class="page-meta">
          <span>{readingTime(doc.body)}</span>
          <PinButton variant="pill" />
        </div>
      </div>
      <h1>{doc.data.title}</h1>
      <slot name="header" />
      <div class="prose">
        <slot />
      </div>
      <ArticleFooter doc={doc} neighbors={getNeighbors(docs, doc)} updated={updated} />
    </article>
    <ArticleAside toc={toc} backlinks={getBacklinks(docs, doc)} />
  </div>
  <TocSheet slot="dialogs" toc={toc} />
</Shell>

<style>
  .wrap {
    display: flex;
    gap: var(--sp-18);
    max-width: var(--article-wrap-max);
    margin: 0 auto;
    align-items: flex-start;
  }

  article {
    flex: 1;
    min-width: 0;
    max-width: var(--article-max);
    padding-bottom: var(--sp-14);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-4) var(--sp-8);
    align-items: center;
  }

  .page-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-3);
  }

  h1 {
    margin: var(--sp-7) 0;
  }

  .prose :global(h2) {
    margin: var(--sp-16) 0 var(--sp-8);
    padding-top: var(--sp-10);
    border-top: var(--bw) solid var(--border-soft);
  }

  .prose :global(h3) {
    margin: var(--sp-10) 0 var(--sp-4);
  }

  .prose :global(p) {
    color: var(--text-2);
  }
</style>
