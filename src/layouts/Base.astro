---
import '../styles/global.css';
import { SITE, STORAGE } from '../data/site';
import { PROFILE } from '../data/profile';
import { OG_VERSION } from '../lib/og-version.mjs';
import sans from '../assets/fonts/atkinson-hyperlegible-next-latin-200-800-normal.woff2?url';
import mono from '../assets/fonts/atkinson-hyperlegible-mono-latin-200-800-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Page à ne pas référencer (404). */
  noindex?: boolean;
  /** Données structurées schema.org, écrites en JSON-LD (accueil : la personne derrière le site). */
  structuredData?: Record<string, unknown>;
}

const { title, description = "Base de connaissances personnelle d'analyste SOC.", noindex = false, structuredData } = Astro.props;
// Accueil : le nom figure dans le titre, pour qu'une recherche sur mon nom mène au site.
const homeTitle = `${SITE.name} — ${SITE.tagline} de ${PROFILE.name}`;
const fullTitle = title ? `${title} — ${SITE.name}` : homeTitle;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// Image de partage, versionnée par son empreinte (voir lib/og-version.mjs).
const ogImage = new URL(`${base}og.png?v=${OG_VERSION}`, Astro.site).href;
const ogAlt = `${SITE.name}, carnet d'analyste SOC de ${PROFILE.name} : observer, détecter, qualifier, répondre.`;
---

<!doctype html>
<html lang="fr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="sitemap" href={`${base}sitemap.xml`} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title ?? homeTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta name="description" content={description} />
    <!-- JSON-LD : chaque « < » devient une séquence Unicode (caractère 92 = barre oblique inverse), pour qu’aucune valeur ne ferme la balise script. -->
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, String.fromCharCode(92) + "u003c")} />}
    <!-- Thème appliqué avant le premier rendu pour éviter tout flash : choix mémorisé, sinon préférence système, sinon clair. -->
    <script is:inline define:vars={{ STORAGE }}>
      (function () {
        var theme = null;
        var sidebar = null;
        try {
          theme = localStorage.getItem(STORAGE.theme);
          sidebar = localStorage.getItem(STORAGE.sidebar);
        } catch (e) {}
        if (theme !== 'dark' && theme !== 'light') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
        if (sidebar === 'closed') document.documentElement.setAttribute('data-sidebar', 'closed');
      })();
    </script>
    {[sans, mono].map((href) => <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />)}
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <slot />
  </body>
</html>
