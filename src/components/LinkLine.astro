---
// Ligne de liens en fin de page : « Techniques liées », « Fiches enrichies », « Utilisé dans ».
import LinePill from './LinePill.astro';

interface Props {
  label: string;
  links: { label: string; href: string; num?: string }[];
}

const { label, links } = Astro.props;
---

{
  links.length > 0 && (
    <p class="link-line">
      <span class="label">{label} :</span>
      {links.map((link) => (
        <a class="chip" href={link.href}>
          {link.num && <LinePill num={link.num} size="sm" decorative />}
          {link.label}
        </a>
      ))}
    </p>
  )
}

<style>
  .link-line {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    align-items: center;
    margin: var(--sp-12) 0 0;
    padding-top: var(--sp-10);
    border-top: var(--bw) solid var(--border-soft);
    font-size: var(--fs-base);
    color: var(--text-2);
  }

  .label {
    margin-right: var(--sp-2);
  }

  .chip {
    padding-left: var(--sp-2);
    font-weight: var(--fw-medium);
  }

  .chip:not(:has(.line-pill)) {
    padding-left: var(--sp-5);
  }
</style>
