---
// Carte à en-tête de l'accueil : titre à gauche, mention à droite.
interface Props {
  title: string;
  note?: string;
}

const { title, note } = Astro.props;
---

<section class="panel" aria-label={title}>
  <div class="head">
    <h2 class="title">{title}</h2>
    {note && <span class="note">{note}</span>}
  </div>
  <slot />
</section>

<style>
  .panel {
    display: flex;
    flex-direction: column;
    border: var(--bw) solid var(--border);
    border-radius: var(--r-panel);
    background: var(--surface);
    overflow: hidden;
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-6);
    padding: var(--sp-7) var(--sp-8) var(--sp-5);
  }

  .title {
    font-size: var(--fs-h3);
    font-weight: var(--fw-black);
    letter-spacing: 0;
  }

  .note {
    font-size: var(--fs-sm);
    color: var(--text-3);
  }
</style>
