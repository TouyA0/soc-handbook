---
import type { Crumb } from '../lib/nav';
import LinePill from './LinePill.astro';

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav class="crumbs" aria-label="Fil d'Ariane">
  <ol>
    {
      crumbs.map((crumb, i) => {
        const last = i === crumbs.length - 1;
        return (
          <li aria-current={last ? 'page' : undefined}>
            {crumb.num && <LinePill num={crumb.num} size="sm" />}
            {crumb.href && !last ? <a href={crumb.href}>{crumb.label}</a> : <span>{crumb.label}</span>}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    align-items: center;
    font-size: var(--fs-md);
    color: var(--text-2);
  }

  li {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    min-height: var(--pill);
  }

  li + li::before {
    content: '›';
    color: var(--text-3);
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--pill);
    color: inherit;
  }

  a:hover {
    color: var(--text);
  }

  li[aria-current='page'] span {
    color: var(--text);
  }
</style>
