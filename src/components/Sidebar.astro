---
import { lineStyle } from '../data/sections';
import type { Doc } from '../lib/content';
import { getNavSections, getStatsParts } from '../lib/nav';
import Icon from './Icon.astro';
import LinePill from './LinePill.astro';

interface Props {
  docs: Doc[];
  currentId?: string;
}

const { docs, currentId } = Astro.props;
const sections = getNavSections(docs, currentId);
const stats = getStatsParts(docs);
---

<nav class="sidebar" id="navigation" aria-label="Navigation principale" tabindex="-1">
  <div class="group" data-nav-group="pins" hidden>
    <h2 class="caps">Épinglés</h2>
    <ul data-nav-list="pins"></ul>
  </div>
  <div class="group" data-nav-group="recents" hidden>
    <h2 class="caps">Vus récemment</h2>
    <ul data-nav-list="recents"></ul>
  </div>
  <template data-nav-template>
    <li>
      <a class="entry">
        <span class="line-pill sm entry-pill" aria-hidden="true"></span>
        <span class="entry-label"></span>
        <span class="entry-meta"></span>
      </a>
    </li>
  </template>

  <h2 class="caps base-title">Sections</h2>

  <ul class="sections">
    {
      sections.map(({ section, href, active, current, children }) => (
        <li style={lineStyle(section.num)}>
          <div class:list={['section', { 'is-active': active }]}>
            <a href={href} aria-current={current ? 'page' : undefined} data-section-link={section.num}>
              <LinePill num={section.num} decorative />
              <span class="section-label">
                <span class="visually-hidden">{section.num} </span>
                {section.title}
              </span>
              <span class="count">
                {children.length}
                <span class="visually-hidden"> fiche{children.length > 1 ? 's' : ''}</span>
              </span>
            </a>
            {children.length > 0 && (
              <button
                type="button"
                class="caret"
                data-action="toggle-section"
                aria-expanded={active ? 'true' : 'false'}
                aria-controls={`nav-${section.num}`}
                aria-label={`Déplier ${section.title}`}
              >
                <Icon name="chevron" size="sm" />
              </button>
            )}
          </div>
          {children.length > 0 && (
            <ul class="children" id={`nav-${section.num}`} hidden={!active}>
              {children.map((child) => (
                <li>
                  <a href={child.href} aria-current={child.current ? 'page' : undefined}>
                    <span>{child.label}</span>
                    {child.meta && <span class="child-meta">{child.meta}</span>}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>

  <div class="foot">
    <p>{stats.counts}</p>
    {stats.updated && <p>{stats.updated}</p>}
    <p class="hint">
      Raccourci : <kbd class="kbd">g</kbd> puis <kbd class="kbd">0</kbd> à <kbd class="kbd">8</kbd> ouvre une section.
    </p>
  </div>
</nav>

<nav class="rail" aria-label="Sections">
  {
    sections.map(({ section, active }) => (
      <button
        type="button"
        class:list={{ 'is-active': active }}
        style={lineStyle(section.num)}
        data-action="open-section"
        data-section={section.num}
        title={section.title}
        aria-label={`${section.num} ${section.title}`}
      >
        <span class="line-pill" aria-hidden="true">{section.num}</span>
      </button>
    ))
  }
</nav>

<div class="scrim" data-action="close-drawer"></div>

<style>
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  p {
    margin: 0;
  }

  .sidebar {
    position: sticky;
    top: var(--topbar-h);
    height: calc(100vh - var(--topbar-h) - var(--statusbar-h));
    width: var(--sidebar-w);
    flex: none;
    overflow-y: auto;
    background: var(--bg-2);
    border-right: var(--bw) solid var(--border);
    padding: var(--sp-10) var(--sp-6) var(--sp-10);
    outline: none;
  }

  .group {
    margin-bottom: var(--sp-8);
  }

  .caps {
    margin: 0;
    padding: 0 var(--sp-4) var(--sp-4);
    font-size: var(--fs-sm);
  }

  .group ul,
  .sections {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .entry {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    min-height: var(--ctl-sm);
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--r-md);
    font-size: var(--fs-md);
    color: var(--text-2);
  }

  .entry:hover,
  .section:hover,
  .children a:hover {
    background: var(--bg);
    text-decoration: none;
  }

  .entry[aria-current='page'] {
    background: var(--surface-2);
    color: var(--text);
    font-weight: var(--fw-bold);
  }

  .entry-pill:empty {
    display: none;
  }

  .entry-label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .entry-meta,
  .child-meta {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    color: var(--text-3);
  }

  .base-title {
    padding-top: var(--sp-4);
  }

  .section {
    display: flex;
    align-items: center;
    border-radius: var(--r-md);
    color: var(--text);
  }

  .section.is-active {
    background: var(--surface-2);
    font-weight: var(--fw-bold);
  }

  .section a {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    min-height: var(--ctl);
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--r-md);
    font-size: var(--fs-base);
    color: inherit;
  }

  .section a:hover {
    text-decoration: none;
  }

  .section-label {
    flex: 1;
    min-width: 0;
  }

  .count {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: var(--fw-regular);
    color: var(--text-3);
  }

  .caret {
    flex: none;
    width: var(--ctl-sm);
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: var(--r-md);
    background: transparent;
    cursor: pointer;
    color: var(--text-3);
  }

  .caret[aria-expanded='true'] :global(.icon) {
    transform: rotate(90deg);
  }

  /* Les pages d'une section sont reliées à leur ligne par un trait de sa couleur */
  .children {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    margin: var(--sp-1) 0 var(--sp-4) calc(var(--sp-4) + var(--pill) / 2 - var(--sp-1));
    padding-left: var(--sp-5);
    border-left: var(--bw-strong) solid var(--line);
  }

  .children[hidden] {
    display: none;
  }

  .children a {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    min-height: var(--ctl-sm);
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--r-md);
    font-size: var(--fs-md);
    line-height: var(--lh-snug);
    color: var(--text-2);
  }

  .children a[aria-current='page'] {
    background: var(--surface-2);
    color: var(--text);
    font-weight: var(--fw-bold);
  }

  .foot {
    margin: var(--sp-10) var(--sp-4) 0;
    padding-top: var(--sp-7);
    border-top: var(--bw) solid var(--border);
    font-size: var(--fs-sm);
    line-height: var(--lh-ui);
    color: var(--text-2);
  }

  .hint {
    margin-top: var(--sp-5);
    color: var(--text-3);
  }

  .rail {
    display: none;
    position: sticky;
    top: var(--topbar-h);
    height: calc(100vh - var(--topbar-h) - var(--statusbar-h));
    width: var(--rail-w);
    flex: none;
    flex-direction: column;
    gap: var(--sp-2);
    background: var(--bg-2);
    border-right: var(--bw) solid var(--border);
    padding: var(--sp-7) var(--sp-4);
  }

  .rail button {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--ctl);
    border: none;
    border-radius: var(--r-md);
    cursor: pointer;
    background: transparent;
  }

  .rail button:hover,
  .rail button.is-active {
    background: var(--surface-2);
  }

  .scrim {
    display: none;
  }

  :global(html[data-sidebar='closed']) .sidebar {
    display: none;
  }

  :global(html[data-sidebar='closed']) .rail {
    display: flex;
  }

  /* Mobile : la barre latérale devient un tiroir, fermé par défaut. */
  @media (max-width: 859px) {
    .rail,
    :global(html[data-sidebar='closed']) .rail,
    .sidebar,
    :global(html[data-sidebar='closed']) .sidebar {
      display: none;
    }

    :global(html[data-drawer='open']) .sidebar {
      display: block;
      position: fixed;
      top: var(--topbar-h);
      bottom: 0;
      left: 0;
      z-index: calc(var(--z-drawer) + 1);
      width: var(--drawer-w);
      max-width: var(--drawer-max);
      height: auto;
      padding: var(--sp-8) var(--sp-6) var(--sp-21);
    }

    :global(html[data-drawer='open']) .scrim {
      display: block;
      position: fixed;
      inset: var(--topbar-h) 0 0 0;
      z-index: var(--z-drawer);
      background: var(--overlay);
    }

    /* Pas de clavier sur téléphone : le rappel du raccourci n'a pas d'objet. */
    .group,
    .child-meta,
    .hint {
      display: none;
    }

    .section a {
      min-height: var(--tap);
      font-size: var(--fs-body);
    }

    .children a {
      min-height: var(--tap);
      font-size: var(--fs-base);
    }
  }
</style>
