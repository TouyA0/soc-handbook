---
interface Props {
  label: string;
  /** `tag` : préfixé d'un # ; `plain` : libellé seul ; `outline` : mention secondaire, plus discrète. */
  variant?: 'tag' | 'plain' | 'outline';
}

const { label, variant = 'tag' } = Astro.props;
---

<span class:list={['chip', variant]}>{variant === 'tag' ? `#${label}` : label}</span>

<style>
  .outline {
    border-style: dashed;
    color: var(--text-2);
  }
</style>
