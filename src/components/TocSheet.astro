---
// Sommaire en panneau bas, ouvert depuis la barre d'actions mobile.
import type { MarkdownHeading } from 'astro';

interface Props {
  toc: MarkdownHeading[];
  /** Premier numéro du sommaire : 1 d'ordinaire, 0 sur un write-up. */
  tocStart?: number;
}

const { toc, tocStart = 1 } = Astro.props;
---

<dialog class="sheet" data-dialog="toc" aria-labelledby="toc-sheet-title">
  <div class="head">
    <h2 id="toc-sheet-title">Sur cette page</h2>
    <button type="button" class="kbd" data-action="close-dialog" aria-label="Fermer">Esc</button>
  </div>
  {
    toc.length > 0 ? (
      <nav aria-label="Sommaire" data-toc style={`--toc-start: ${tocStart - 1}`}>
        {toc.map((h) => (
          <a href={`#${h.slug}`} class:list={{ sub: h.depth === 3 }} data-action="close-dialog">
            {h.text}
          </a>
        ))}
      </nav>
    ) : (
      <p>Cette page n'a pas de sections.</p>
    )
  }
</dialog>

<style>
  .sheet {
    position: fixed;
    inset: auto 0 0 0;
    width: 100%;
    max-width: none;
    max-height: var(--sheet-max-h);
    margin: 0;
    overflow-y: auto;
    background: var(--surface);
    color: var(--text);
    border: none;
    border-top: var(--bw) solid var(--border);
    border-radius: var(--r-sheet) var(--r-sheet) 0 0;
    padding: var(--sp-8) var(--sp-8) var(--sp-10);
  }

  .sheet::backdrop {
    background: var(--overlay);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--sp-4);
  }

  h2 {
    font-size: var(--fs-h3);
  }

  .head button {
    background: transparent;
    cursor: pointer;
  }

  nav {
    counter-reset: toc var(--toc-start, 0);
  }

  a {
    display: flex;
    gap: var(--sp-5);
    align-items: baseline;
    min-height: var(--tap);
    padding: var(--sp-5) 0;
    border-bottom: var(--bw) solid var(--border-soft);
    font-size: var(--fs-body);
    color: var(--text);
  }

  a:not(.sub)::before {
    counter-increment: toc;
    content: counter(toc, decimal-leading-zero);
    flex: none;
    min-width: 2ch;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--text-3);
  }

  a.sub {
    padding-left: calc(2ch + var(--sp-5));
    font-size: var(--fs-base);
    color: var(--text-2);
  }

  a:hover {
    text-decoration: none;
  }

  nav :global(a.is-active) {
    font-weight: var(--fw-bold);
  }

  p {
    margin: var(--sp-6) 0 0;
    font-size: var(--fs-base);
    color: var(--text-3);
  }
</style>
