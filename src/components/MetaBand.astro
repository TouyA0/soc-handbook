---
// Bandeau de métadonnées en tête de page. Chaque case : <div><dt>Libellé</dt><dd>Valeur</dd></div>.
interface Props {
  /** Cases plus étroites, pour des valeurs courtes (write-up). */
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<dl class:list={['meta-band', { compact }]}>
  <slot />
</dl>

<style>
  .meta-band {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(var(--meta-min), 100%), 1fr));
    gap: var(--bw);
    margin: var(--sp-10) 0 0;
    background: var(--surface);
    border: var(--bw) solid var(--border);
    border-radius: var(--r-card);
    overflow: hidden;
  }

  .compact {
    grid-template-columns: repeat(auto-fit, minmax(min(var(--meta-min-sm), 100%), 1fr));
  }

  /* Les séparateurs sont portés par les cases : une rangée incomplète ne laisse pas de vide coloré */
  .meta-band :global(> div) {
    padding: var(--sp-6) var(--sp-8);
    background: var(--surface);
    outline: var(--bw) solid var(--border-soft);
  }

  .meta-band :global(dt) {
    margin-bottom: var(--sp-1);
    font-size: var(--fs-sm);
    color: var(--text-2);
  }

  .meta-band :global(dd) {
    margin: 0;
    font-size: var(--fs-base);
    font-weight: var(--fw-bold);
    line-height: var(--lh-snug);
  }

  .meta-band :global(dd .line-pill) {
    margin-right: var(--sp-3);
    vertical-align: middle;
  }
</style>
