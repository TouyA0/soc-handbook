---
import { SITE } from '../data/site';
import { docUrl, sectionOf, type Doc } from '../lib/content';
import { neighborContext, neighborLabel } from '../lib/nav';
import LinePill from './LinePill.astro';

interface Props {
  doc: Doc;
  neighbors: { prev: Doc | undefined; next: Doc | undefined };
  /** Date de dernière modification, déjà formatée. */
  updated: string;
}

const { doc, neighbors, updated } = Astro.props;
const { prev, next } = neighbors;
const historyUrl = doc.filePath ? `${SITE.repo}/commits/${SITE.branch}/${doc.filePath}` : undefined;
const issueUrl = `${SITE.repo}/issues/new?title=${encodeURIComponent(`Erreur dans « ${doc.data.title} »`)}`;
---

{
  (prev || next) && (
    <nav class="neighbors" aria-label="Pages voisines">
      {prev && (
        <a class="prev" href={docUrl(prev.id)} rel="prev">
          <span class="dir">Précédent</span>
          <span class="ctx">
            {sectionOf(prev) && <LinePill num={sectionOf(prev)!.num} size="sm" decorative />}
            {neighborContext(prev)}
          </span>
          <span class="label">{neighborLabel(prev)}</span>
        </a>
      )}
      {next && (
        <a class="next" href={docUrl(next.id)} rel="next">
          <span class="dir">Suivant</span>
          <span class="ctx">
            {neighborContext(next)}
            {sectionOf(next) && <LinePill num={sectionOf(next)!.num} size="sm" decorative />}
          </span>
          <span class="label">{neighborLabel(next)}</span>
        </a>
      )}
    </nav>
  )
}

<footer>
  <span>Dernière modification le {updated}</span>
  <span class="links">
    {historyUrl && <a href={historyUrl} target="_blank" rel="noopener noreferrer">Historique sur GitHub</a>}
    <a href={issueUrl} target="_blank" rel="noopener noreferrer">Signaler une erreur</a>
  </span>
</footer>

<style>
  .neighbors {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(var(--neighbor-min), 100%), 1fr));
    gap: var(--sp-5);
    margin-top: var(--sp-18);
  }

  .neighbors a {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-2);
    padding: var(--sp-7) var(--sp-8);
    border: var(--bw) solid var(--border);
    border-radius: var(--r-card);
    background: var(--surface);
    color: var(--text);
    line-height: var(--lh-snug);
  }

  .neighbors a:hover {
    border-color: var(--border-strong);
    text-decoration: none;
  }

  .neighbors .next {
    align-items: flex-end;
    text-align: right;
  }

  /* Seule page voisine = la suivante : elle reste dans la colonne de droite. */
  .neighbors .next:first-child {
    grid-column: -2;
  }

  .dir {
    font-size: var(--fs-sm);
    color: var(--text-3);
  }

  .ctx {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    font-size: var(--fs-sm);
    color: var(--text-2);
  }

  .label {
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-bold);
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-6);
    margin-top: var(--sp-9);
    padding-top: var(--sp-8);
    border-top: var(--bw) solid var(--border-soft);
    font-size: var(--fs-sm);
    color: var(--text-2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-8);
  }

  .links a {
    display: inline-block;
    padding: var(--sp-2) 0;
    color: var(--text-2);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .links a:hover {
    color: var(--text);
  }
</style>
