---
import Icon from './Icon.astro';

interface Props {
  /** Vrai sur un article : le troisième bouton ouvre le sommaire au lieu de remonter en haut de page. */
  hasToc: boolean;
}

const { hasToc } = Astro.props;
---

<nav class="mobilebar" aria-label="Navigation mobile">
  <button type="button" class="menu" data-action="toggle-sidebar"><Icon name="menu" size="lg" />Menu</button>
  <button type="button" data-action="open-search"><Icon name="search" size="lg" />Rechercher</button>
  {
    hasToc ? (
      <button type="button" data-action="open-toc"><Icon name="list" size="lg" />Sommaire</button>
    ) : (
      <button type="button" data-action="top"><Icon name="arrow-up" size="lg" />Haut</button>
    )
  }
</nav>

<style>
  .mobilebar {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-bottombar);
    grid-template-columns: repeat(3, 1fr);
    min-height: var(--mobilebar-h);
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--bg-2);
    border-top: var(--bw) solid var(--border);
  }

  button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    min-height: var(--mobilebar-h);
    border: none;
    background: transparent;
    cursor: pointer;
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    color: var(--text-2);
  }

  :global(html[data-drawer='open']) .menu {
    background: var(--surface-2);
    color: var(--text);
  }

  @media (max-width: 859px) {
    .mobilebar {
      display: grid;
    }
  }
</style>
