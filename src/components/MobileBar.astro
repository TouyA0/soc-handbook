---
interface Props {
  /** Vrai sur un article : le troisième bouton ouvre le sommaire au lieu de remonter en haut de page. */
  hasToc: boolean;
}

const { hasToc } = Astro.props;
---

<nav class="mobilebar" aria-label="Navigation mobile">
  <button type="button" class="menu" data-action="toggle-sidebar"><span class="bar"></span>Menu</button>
  <button type="button" class="is-accent" data-action="open-search"><span class="bar"></span>Rechercher</button>
  {
    hasToc ? (
      <button type="button" data-action="open-toc"><span class="bar"></span>Sommaire</button>
    ) : (
      <button type="button" data-action="top"><span class="bar"></span>Haut</button>
    )
  }
</nav>

<style>
  .mobilebar {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-bottombar);
    grid-template-columns: repeat(3, 1fr);
    height: var(--mobilebar-h);
    background: var(--bg-2);
    border-top: var(--bw) solid var(--border);
  }

  button {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
    border: none;
    background: transparent;
    cursor: pointer;
    font-size: var(--fs-sm);
    color: var(--text-2);
  }

  .bar {
    width: var(--sp-8h);
    height: var(--sp-1h);
    border-radius: var(--r-xs);
    background: var(--border);
  }

  .is-accent,
  :global(html[data-drawer='open']) .menu {
    color: var(--accent);
  }

  .is-accent .bar,
  :global(html[data-drawer='open']) .menu .bar {
    background: var(--accent);
  }

  @media (max-width: 859px) {
    .mobilebar {
      display: grid;
    }
  }
</style>
