---
// Cartes « Pratiqué dans » : les write-ups où une technique a été rencontrée.
import { PLATFORMS } from '../data/writeups';
import { docUrl, type DocOf } from '../lib/content';
import { formatDate } from '../lib/nav';
import LinePill from './LinePill.astro';

interface Props {
  writeups: DocOf<'writeup'>[];
}

const { writeups } = Astro.props;
---

<div class="cards">
  {
    writeups.map((w) => (
      <a href={docUrl(w.id)}>
        <span class="top">
          <LinePill num="06" size="sm" decorative />
          <span>{PLATFORMS[w.data.platform]}</span>
          <span class="date">{formatDate(w.data.date)}</span>
        </span>
        <span class="title">{w.data.title}</span>
        <span class="note">{w.data.description}</span>
        <span class="more">Lire le write-up</span>
      </a>
    ))
  }
</div>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--card-min), 1fr));
    gap: var(--sp-5);
  }

  a {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding: var(--sp-7) var(--sp-8);
    border: var(--bw) solid var(--border);
    border-top: var(--bw-line) solid var(--l06);
    border-radius: var(--r-card);
    background: var(--surface);
    color: var(--text);
    line-height: var(--lh-snug);
  }

  a:hover {
    border-color: var(--border-strong);
    border-top-color: var(--l06);
    text-decoration: none;
  }

  .top {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--text-2);
  }

  .date {
    margin-left: auto;
    font-family: var(--font-mono);
    color: var(--text-3);
  }

  .title {
    font-size: var(--fs-body);
    font-weight: var(--fw-bold);
  }

  .note {
    font-size: var(--fs-md);
    color: var(--text-2);
  }

  .more {
    margin-top: auto;
    font-size: var(--fs-md);
    font-weight: var(--fw-bold);
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }
</style>
