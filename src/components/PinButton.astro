---
import Icon from './Icon.astro';

interface Props {
  /** `pill` : pastille de l'en-tête d'article ; `link` : lien discret de la colonne de droite. */
  variant: 'pill' | 'link';
}

const { variant } = Astro.props;
---

<button type="button" class:list={['pin', variant]} data-action="pin" aria-pressed="false" title="Épingler (p)">
  <Icon name="pin" size="sm" />
  <span class="off">Épingler</span>
  <span class="on">Épinglé</span>
</button>

<style>
  .pin {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2h);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    background: transparent;
    cursor: pointer;
    color: var(--text-2);
  }

  .pill {
    padding: var(--sp-1h) var(--sp-4h);
    border: var(--bw) solid var(--border);
    border-radius: var(--r-pill);
  }

  .link {
    padding: 0;
    border: none;
  }

  .on,
  .pin[aria-pressed='true'] .off {
    display: none;
  }

  .pin[aria-pressed='true'] .on {
    display: inline;
  }

  .pin[aria-pressed='true'] {
    color: var(--accent);
    border-color: var(--accent-line);
  }

  /* Épinglé : le pictogramme se remplit. */
  .pin[aria-pressed='true'] :global(.icon) {
    fill: currentColor;
  }
</style>
