---
import { SITE } from '../data/site';
import { docUrl } from '../lib/content';
import Icon from './Icon.astro';
---

<header class="topbar">
  <button class="icon-btn" type="button" data-action="toggle-sidebar" aria-label="Afficher ou replier la navigation" aria-expanded="true" aria-controls="navigation">
    <Icon name="sidebar" />
  </button>

  <a class="logo" href={docUrl('')} aria-label={`Accueil ${SITE.name}`} data-home-link>
    <!-- Le « k » de soc.kb en jonction de plan : la ligne 01 rejoint la ligne 03, la station marque la correspondance. Même dessin que public/favicon.svg -->
    <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true">
      <path class="l3" d="M8 3v26" fill="none" stroke-width="5.5" stroke-linecap="round"></path>
      <path class="l1" d="M27 5L10 19.5L27 29" fill="none" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round"></path>
      <circle class="st" cx="9" cy="19.5" r="4.75" stroke-width="2.75"></circle>
    </svg>
    <span class="logo-text">{SITE.name}</span>
  </a>

  <button class="search" type="button" data-action="open-search" aria-label="Recherche globale (Ctrl K)">
    <Icon name="search" size="sm" />
    <span class="search-placeholder"><span class="long">Rechercher une fiche, un filtre, un Event ID…</span><span class="short">Rechercher</span></span>
    <span class="search-keys desktop-only" aria-hidden="true"><kbd class="kbd">Ctrl</kbd><kbd class="kbd">K</kbd></span>
  </button>

  <button class="ctl desktop-only" type="button" data-action="open-help" aria-label="Raccourcis clavier" title="Raccourcis clavier (?)">
    <Icon name="keyboard" />
  </button>

  <button class="ctl theme desktop-only" type="button" data-action="toggle-theme" aria-pressed="false">
    <span class="swatch" aria-hidden="true"></span>
    <span class="when-light">Thème sombre</span>
    <span class="when-dark">Thème clair</span>
  </button>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: var(--z-topbar);
    height: var(--topbar-h);
    display: flex;
    align-items: center;
    gap: var(--sp-6);
    padding: 0 var(--sp-8);
    background: var(--bg-2);
    border-bottom: var(--bw) solid var(--border);
  }

  .icon-btn,
  .ctl {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-4);
    min-height: var(--ctl);
    padding: 0 var(--sp-5);
    background: var(--surface);
    border: var(--bw) solid var(--border-strong);
    border-radius: var(--r-lg);
    cursor: pointer;
    color: var(--text-2);
    font-size: var(--fs-md);
    font-weight: var(--fw-medium);
  }

  .icon-btn {
    width: var(--ctl);
    padding: 0;
  }

  .icon-btn:hover,
  .ctl:hover {
    color: var(--text);
    border-color: var(--text-3);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    flex: none;
    min-height: var(--tap);
    color: var(--text);
    font-size: var(--fs-h3);
    font-weight: var(--fw-black);
    letter-spacing: var(--ls-h2);
  }

  .logo:hover {
    text-decoration: none;
  }

  .logo-mark {
    width: var(--logo);
    height: var(--logo);
    flex: none;
  }

  .logo-mark .l1 {
    stroke: var(--l01);
  }

  .logo-mark .l3 {
    stroke: var(--l03);
  }

  .logo-mark .st {
    fill: var(--bg-2);
    stroke: var(--text);
  }

  .search {
    flex: 1;
    min-width: 0;
    max-width: var(--search-max);
    margin: 0 auto;
    min-height: var(--ctl);
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    padding: 0 var(--sp-6);
    background: var(--bg);
    border: var(--bw) solid var(--border-strong);
    border-radius: var(--r-2xl);
    cursor: pointer;
    color: var(--text-2);
    font-size: var(--fs-base);
    text-align: left;
  }

  .search:hover {
    border-color: var(--text-3);
    color: var(--text);
  }

  .search-placeholder {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .search .short {
    display: none;
  }

  .search-keys {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .swatch {
    width: var(--icon);
    height: var(--icon);
    border-radius: 50%;
    border: var(--bw-strong) solid currentColor;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
  }

  .when-dark,
  :global(html[data-theme='dark']) .when-light {
    display: none;
  }

  :global(html[data-theme='dark']) .when-dark {
    display: inline;
  }

  :global(html[data-theme='dark']) .swatch {
    background: linear-gradient(90deg, transparent 50%, currentColor 50%);
  }

  @media (max-width: 859px) {
    .desktop-only {
      display: none;
    }

    .search .long {
      display: none;
    }

    .search .short {
      display: inline;
    }
  }
</style>
