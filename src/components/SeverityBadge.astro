---
// Sévérité en libellé + segments remplis (1 à 5) : lisible sans la couleur, et sans confusion avec la ligne 03.
import { SEVERITIES, type Severity } from '../data/attack';

interface Props {
  severity: Severity;
  /** Libellé affiché ; par défaut, celui de la sévérité (« Élevé »). */
  label?: string;
  /** Mot lu avant le libellé par un lecteur d'écran (« Sévérité », « Difficulté »). */
  kind?: string;
}

const LEVELS: Record<Severity, number> = { info: 1, low: 2, med: 3, high: 4, crit: 5 };
const { severity, label = SEVERITIES[severity], kind = 'Sévérité' } = Astro.props;
const level = LEVELS[severity];
---

<span class:list={['severity', severity]}>
  <span class="visually-hidden">{kind} : </span>
  <span>{label}</span>
  <span class="gauge" aria-hidden="true">
    {Array.from({ length: 5 }, (_, i) => <i class:list={{ on: i < level }} />)}
  </span>
</span>

<style>
  .severity {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-4);
    min-height: var(--pill);
    padding: 0 var(--sp-5);
    border: var(--bw) solid var(--border-strong);
    border-radius: var(--r-pill);
    background: var(--surface);
    color: var(--text);
    font-size: var(--fs-md);
    font-weight: var(--fw-bold);
    line-height: 1;
  }

  .gauge {
    display: inline-flex;
    gap: var(--sp-1);
  }

  .gauge i {
    width: var(--sp-3);
    height: var(--sp-7);
    border: var(--bw) solid var(--text);
    border-radius: var(--r-xs);
    background: transparent;
  }

  .gauge .on {
    background: var(--sev);
    border-color: var(--sev);
  }

  .info {
    --sev: var(--sev-info);
  }

  .low {
    --sev: var(--sev-low);
  }

  .med {
    --sev: var(--sev-med);
  }

  .high {
    --sev: var(--sev-high);
  }

  .crit {
    --sev: var(--sev-crit);
  }

  @media (forced-colors: active) {
    .gauge .on {
      forced-color-adjust: none;
      background: CanvasText;
      border-color: CanvasText;
    }
  }
</style>
