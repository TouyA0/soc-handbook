---
// En-tête d'article sous le titre : chapô, badges, bandeau de métadonnées et blocs propres à chaque type de page.
import type { MarkdownHeading } from 'astro';
import { TACTICS } from '../data/attack';
import { DIFFICULTIES, PLATFORMS } from '../data/writeups';
import { sectionOf, type Doc } from '../lib/content';
import { formatDate, formatDuration } from '../lib/nav';
import AttackBadge from './AttackBadge.astro';
import Callout from './Callout.astro';
import CheatFilter from './CheatFilter.astro';
import KnowledgeThread, { type ThreadStep } from './KnowledgeThread.astro';
import LinePill from './LinePill.astro';
import MetaBand from './MetaBand.astro';
import SeverityBadge from './SeverityBadge.astro';
import Tag from './Tag.astro';

interface Props {
  doc: Doc;
  headings: MarkdownHeading[];
  /** Fil de connaissance, calculé par le layout pour les techniques. */
  thread?: ThreadStep[];
}

const { doc, headings, thread = [] } = Astro.props;
const { data } = doc;
const tactic = data.type === 'technique' ? TACTICS.find((t) => t.slug === data.tactic) : undefined;
const sectionNum = sectionOf(doc)?.num;
---

<p class="lead">{data.description}</p>

{
  data.type === 'technique' && (
    <>
      <div class="row">
        <AttackBadge id={data.attack_id} />
        <SeverityBadge severity={data.severity} />
        {data.tags.map((tag) => (
          <Tag label={tag} />
        ))}
      </div>
      <MetaBand>
        {tactic && (
          <div>
            <dt>Tactique</dt>
            <dd>
              {sectionNum && <LinePill num={sectionNum} size="sm" decorative />}
              {tactic.name} <span class="muted">{tactic.id}</span>
            </dd>
          </div>
        )}
        {data.platforms.length > 0 && (
          <div>
            <dt>Plateformes</dt>
            <dd>{data.platforms.join(', ')}</dd>
          </div>
        )}
        {data.data_sources.length > 0 && (
          <div>
            <dt>Sources de données</dt>
            <dd>{data.data_sources.join(', ')}</dd>
          </div>
        )}
        {data.detection_confidence && (
          <div>
            <dt>Fiabilité de la détection</dt>
            <dd>{data.detection_confidence}</dd>
          </div>
        )}
        <div>
          <dt>Mise à jour</dt>
          <dd class="mono">{formatDate(data.updated)}</dd>
        </div>
      </MetaBand>
      {thread.length > 1 && <KnowledgeThread steps={thread} />}
    </>
  )
}

{
  data.type === 'cheatsheet' && (
    <>
      <div class="row">
        <Tag label="Cheat sheet" variant="plain" />
        {data.tags.map((tag) => (
          <Tag label={tag} />
        ))}
        {data.tested_version && <Tag label={`Testé sur ${data.tested_version}`} variant="outline" />}
      </div>
      <CheatFilter headings={headings} />
    </>
  )
}

{
  data.type === 'writeup' && (
    <>
      <MetaBand compact>
        <div>
          <dt>Plateforme</dt>
          <dd>{PLATFORMS[data.platform]}</dd>
        </div>
        <div>
          <dt>Difficulté</dt>
          <dd>
            <SeverityBadge severity={DIFFICULTIES[data.difficulty].severity} label={DIFFICULTIES[data.difficulty].label} kind="Difficulté" />
          </dd>
        </div>
        <div>
          <dt>Date</dt>
          <dd class="mono">{formatDate(data.date)}</dd>
        </div>
        {data.duration && (
          <div>
            <dt>Durée</dt>
            <dd class="mono">environ {formatDuration(data.duration)}</dd>
          </div>
        )}
      </MetaBand>
      {(data.skills.length > 0 || data.tags.length > 0) && (
        <div class="row skills">
          <span class="caps">Compétences :</span>
          {[...new Set([...data.skills, ...data.tags])].map((skill) => (
            <Tag label={skill} />
          ))}
        </div>
      )}
      <Callout type="sans-spoiler">
        <p>Les flags, domaines et identifiants exacts sont masqués. Je documente la démarche, pas les réponses.</p>
      </Callout>
    </>
  )
}

{
  data.type === 'page' && data.tags.length > 0 && (
    <div class="row">
      {data.tags.map((tag) => (
        <Tag label={tag} />
      ))}
    </div>
  )
}

<style>
  .lead {
    max-width: var(--lead-max);
    margin: 0 0 var(--sp-10);
    font-size: var(--fs-lead);
    line-height: var(--lh-dense);
    color: var(--text-2);
    text-wrap: pretty;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    align-items: center;
  }

  .skills {
    margin-top: var(--sp-8);
  }

  .mono {
    font-family: var(--font-mono);
    font-size: var(--fs-md);
  }

  .muted {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: var(--fw-regular);
    color: var(--text-3);
  }
</style>
