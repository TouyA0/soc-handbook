---
interface Props {
  /** Identifiant ATT&CK, ex. `T1558.003`. */
  id: string;
  /** `full` : marque « A » + identifiant ; `compact` : identifiant seul, plus petit. */
  variant?: 'full' | 'compact';
}

const { id, variant = 'full' } = Astro.props;
---

<span class:list={['attack', variant]}>
  {variant === 'full' && <span class="mark" aria-hidden="true">A</span>}
  <span class="visually-hidden">Technique MITRE ATT&amp;CK </span>
  <span class="id">{id}</span>
</span>

<style>
  .attack {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-4);
    min-height: var(--pill);
    padding: 0 var(--sp-5) 0 var(--sp-3);
    border: var(--bw-strong) solid var(--text);
    border-radius: var(--r-sm);
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    line-height: 1;
    color: var(--text);
  }

  .mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--pill-sm);
    height: var(--pill-sm);
    border-radius: 50%;
    background: var(--l03);
    color: var(--on-line);
    font-size: var(--fs-2xs);
  }

  .compact {
    min-height: var(--pill-sm);
    padding: 0 var(--sp-3);
    border-width: var(--bw);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
  }
</style>
